# Copy to .env and adjust. No secrets are required — everything runs locally.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./clinic.db
CLINIC_TIMEZONE=Asia/Karachi
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Paths are relative to backend/ by default
MODELS_DIR=models
NLU_MODEL_PATH=models/nlu.joblib
REPORTS_DIR=reports
# Speech: download models with `python scripts/download_models.py`.
# A provider set to "none", or a model that fails to load, means text-only (no crash);
# with TTS_PROVIDER=none the browser speaks the replies.
# STT_PROVIDER: faster_whisper | none. STT_MODEL tiny.en is faster on slow CPUs.
STT_PROVIDER=faster_whisper
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# TTS_PROVIDER: piper | none. The voice is read from MODELS_DIR/<TTS_VOICE>.onnx.
TTS_PROVIDER=piper
TTS_VOICE=en_US-lessac-medium
