# Copy to backend/.env for local development. Never commit the real file.
APP_ENV=dev                      # dev | test | prod
DATABASE_URL=sqlite:///./data/clinic.db   # or postgresql://user:pass@host:5432/dbname
JWT_SECRET=dev-only-secret-change-me      # prod requires 24+ random characters
COOKIE_SECURE=false              # true when served over https
STAFF_USERNAME=reception
STAFF_PASSWORD=demo-staff-2026   # change it, and set DEMO_MODE=false, for anything real
DEMO_MODE=true                   # seeds fake data and shows sign-in hints in the UI
RATE_LIMIT_PER_MINUTE=120
CALL_IDLE_MINUTES=30
SESSION_RETENTION_HOURS=48
LOG_LEVEL=INFO

# --- operations ---
USE_MIGRATIONS=false             # true = run Alembic at start-up (the Docker image sets this)
TRUSTED_PROXY_COUNT=0            # proxies in front that append to X-Forwarded-For (Render: 1)
METRICS_TOKEN=                   # set to expose GET /metrics (Prometheus) with a bearer token
SENTRY_DSN=                      # optional error reporting; also: pip install sentry-sdk
REMINDERS_ENABLED=false          # background reminders (LogNotifier by default; plug in an SMS sender)
REMINDER_HOURS=24
VERIFY_LOCK_FAILURES=5           # failed identity checks per name before it is locked
VERIFY_LOCK_MINUTES=15
