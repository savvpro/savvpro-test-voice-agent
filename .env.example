# Backend: run from the repository root. No API keys are needed.
VOXDESK_DATABASE_URL=sqlite:///./voxdesk.db
VOXDESK_TIMEZONE=Asia/Karachi
VOXDESK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend: copy this value to frontend/.env.local if changing the backend port.
NEXT_PUBLIC_API_URL=http://localhost:8000
