# No paid keys required. Optional local settings:

# Shared password for the Admin bookings panel (default: admin)
ADMIN_PASSWORD=admin

# SQLite file path (default: backend/data/bookings.db)
# BOOKINGS_DB=backend/data/bookings.db

# Fake email/SMS confirmation log (default: backend/data/notifications.log)
# NOTIFICATIONS_LOG=backend/data/notifications.log

# CORS — comma-separated local origins (defaults cover Vite + Docker UI)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Rate limit on POST /api/turn (per IP+session). Auto-off under pytest.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_TURN=60
# RATE_LIMIT_WINDOW_SEC=60

# Point the Vite app at a remote API instead of the dev proxy (usually leave blank)
# VITE_API_URL=http://127.0.0.1:8000

# LOG_LEVEL=INFO
