{
  "info": {
    "_postman_id": "ac1336ae-2dc5-4ef6-b509-5004bb43011c",
    "name": "REDELIVER Backend",
    "description": "Health check and session lifecycle requests. Select the local environment, then run requests in order for a sample status call.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Returns the service status and configured application version."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health responds successfully', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sample status call (run in order)",
      "item": [
        {
          "name": "1. Create session",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sessions",
            "description": "Creates a conversation and saves its ID to the collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('session created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.session_id).to.be.a('string');",
                  "  pm.collectionVariables.set('sessionId', body.session_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Provide tracking ID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"RD30000001\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sessions/{{sessionId}}/turns"
          }
        },
        {
          "name": "3. Confirm tracking ID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"yes\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sessions/{{sessionId}}/turns"
          }
        },
        {
          "name": "4. Verify phone last four",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"1234\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sessions/{{sessionId}}/turns"
          }
        },
        {
          "name": "5. Ask for parcel status",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"where is my parcel\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sessions/{{sessionId}}/turns"
          }
        },
        {
          "name": "6. Read session history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sessions/{{sessionId}}"
          }
        },
        {
          "name": "7. End session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/sessions/{{sessionId}}"
          }
        }
      ]
    }
  ]
}
