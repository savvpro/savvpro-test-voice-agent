# Backend environment variables — copy to .env and fill in real values.
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev uses SQLite; Docker Compose overrides to Postgres
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Postgres components (used by Docker Compose / Alembic)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brightsmile
POSTGRES_PASSWORD=brightsmile_dev_pw
POSTGRES_DB=brightsmile

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Clinic rules ──────────────────────────────────────────────────────────────
CLINIC_NAME=BrightSmile Dental Clinic
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=17
CLINIC_SLOT_MINUTES=30
CLINIC_OPEN_WEEKDAYS=0,1,2,3,4,5

# ── Session store ─────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=300
SESSION_MAX_SIZE=1000

# ── Voice pipeline ────────────────────────────────────────────────────────────
MAX_AUDIO_BYTES=1048576
MAX_TEXT_CHARS=500
MAX_TURNS=40

# ── STT / TTS ─────────────────────────────────────────────────────────────────
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE=en-US-JennyNeural
